levels = c("lunes",
"martes",
"miércoles",
"jueves",
"viernes"))) %>%
arrange(Año, Dia_txt) %>%
pivot_wider(id_cols = c("Año"),
names_from = c("Dia_txt"),
values_from = c("TC_NFLX"))
